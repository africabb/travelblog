# ─── Postgres ────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/japon_diary

# ─── R2 / S3-compatible storage ──────────────────────────────
# Para Cloudflare R2:
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Para AWS S3:
#   S3_ENDPOINT=   (dejar vacío, el SDK usa el default regional)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=japon-diary-media
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública del bucket (con dominio custom o el público de R2/S3)
S3_PUBLIC_URL=https://media.tudominio.com

# ─── API ─────────────────────────────────────────────────────
PORT=3001
# Clave para que el plugin de Bert pueda escribir en la API
API_SECRET=cambia_esto_por_un_secreto_largo

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,https://tudominio.com

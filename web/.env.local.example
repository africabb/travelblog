# ─── API ─────────────────────────────────────────────────────────
# URL base de la API Fastify
DIARY_API_URL=http://localhost:3001

# El mismo API_SECRET configurado en la API (para llamadas server-side)
DIARY_API_SECRET=cambia_esto_por_un_secreto_largo

# ─── Auth ────────────────────────────────────────────────────────
# PIN que se muestra en /login (puede ser diferente a API_SECRET)
PRIVATE_TOKEN=tu_pin_aqui

# ─── Next.js ─────────────────────────────────────────────────────
# Hostname del bucket de media (R2, S3, CDN…)
# Se usa en next.config.js para permitir <Image> remoto
MEDIA_HOSTNAME=media.tudominio.com
